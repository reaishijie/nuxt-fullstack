{
  "name": "fullstack",
  "type": "module",
  "private": true,
  "scripts": {
    "build": "nuxt build",
    "dev": "nuxt dev",
    "generate": "nuxt generate",
    "preview": "nuxt preview",
    "postinstall": "nuxt prepare",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "nuxt typecheck",
    "test": "vitest run",
    "test:unit": "vitest run --project unit",
    "test:e2e": "vitest run --project e2e",
    "test:watch": "vitest"
  },
  "dependencies": {
    "@pinia/nuxt": "^1.0.3",
    "nuxt": "^4.6.3",
    "pinia": "^4.1.0",
    "vue": "^3.5.44",
    "vue-router": "^5.4.0"
  },
  "devDependencies": {
    "@nuxt/eslint": "^1.17.0",
    "@nuxt/test-utils": "^4.3.4",
    "@tailwindcss/vite": "^4.3.3",
    "@vue/test-utils": "^2.5.1",
    "eslint": "^10.14.0",
    "eslint-config-prettier": "^10.1.8",
    "happy-dom": "^21.0.4",
    "prettier": "^3.9.10",
    "tailwindcss": "^4.3.3",
    "typescript": "^5.9.3",
    "vitest": "^5.0.5",
    "vue-tsc": "^3.3.14"
  }
}
